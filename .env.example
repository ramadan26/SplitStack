# PostgreSQL connection string (Neon or Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5432/splitstack?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic link (SMTP) — e.g. Resend, Postmark, or any SMTP provider.
# Leave EMAIL_SERVER empty (or as the example.com placeholder) in local dev
# and sign-in links will be printed to the server console instead.
EMAIL_SERVER=""
EMAIL_FROM="SplitStack <noreply@example.com>"

# Demo email+password login (mocked) — sign in as any existing/seeded user
# with this shared password. Handy for demos and recruiters on the deployed
# app, where magic-link email delivery may not be configured.
DEMO_PASSWORD="demo1234"
